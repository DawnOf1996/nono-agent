{
  "name": "@nono/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "NoNo desktop shell",
  "author": "NoNo",
  "repository": {
    "type": "git",
    "url": "https://github.com/DawnOf1996/nono-agent.git"
  },
  "homepage": "https://github.com/DawnOf1996/nono-agent",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nono.agent",
    "productName": "NoNo",
    "copyright": "Copyright © NoNo",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "icon.ico",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/sidecar",
        "to": "sidecar"
      },
      {
        "from": "resources/web",
        "to": "web"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "NoNo-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NoNo",
      "uninstallDisplayName": "NoNo",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "DawnOf1996",
      "repo": "nono-agent",
      "releaseType": "release"
    }
  }
}
