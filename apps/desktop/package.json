{
  "name": "@nono/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Nono desktop shell",
  "author": "Nono",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nono.agent",
    "productName": "Nono",
    "copyright": "Copyright © Nono",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "icon.ico",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/sidecar",
        "to": "sidecar"
      },
      {
        "from": "resources/web",
        "to": "web"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Nono-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nono",
      "uninstallDisplayName": "Nono",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false
  }
}
