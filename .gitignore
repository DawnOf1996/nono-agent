dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# editor lock files
.~lock.*

# Node / Electron product layer
node_modules/
apps/web/dist/
apps/desktop/out/
apps/desktop/release/
# 组装区：pack-desktop 每次打包现建现删，只放构建产物。
# 注意别跟 apps/resources/ 搞混 —— 后者是提交进仓库的可外挂输入。
apps/desktop/resources/
*.tsbuildinfo

# 本机运行时产物
# .mavis/ 整个目录都是本地工具运行时生成的（canvas 素材等），不入库。
.mavis/
# runtime-test/ 是有意维护的内容目录（README、verify_*.py、mcp_servers/、.nono-agent/），
# 只忽略跑一次冒烟产生的东西：引擎按 session id 落盘的消息转写。
# 注意别写成 runtime-test/ —— 那会把以后新增的验证脚本和文档一起悄悄吞掉。
runtime-test/*.jsonl

